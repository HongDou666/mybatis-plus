<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zqc.mapper.UserMapper">

    <!-- 自定义 SQL：SET 写在 XML，WHERE 由 Wrapper 的 customSqlSegment 注入 -->
    <update id="deductBalance">
        UPDATE `user`
        SET balance = balance - #{amount}
        ${ew.customSqlSegment}
    </update>

    <!-- 自定义 SQL：关联 address 查用户，WHERE 由 Wrapper 注入（如 u.id IN / a.city =） -->
    <select id="queryUsersByAddress" resultType="com.zqc.domain.po.User">
        SELECT DISTINCT u.*
        FROM `user` u
        INNER JOIN address a ON u.id = a.user_id AND a.deleted = 0
        ${ew.customSqlSegment}
    </select>

</mapper>
